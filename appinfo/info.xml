<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
    <id>mistral_ocr</id>
    <name>Mistral OCR</name>
    <summary>Send files and images to the Mistral OCR API to extract machine-readable Markdown text</summary>
    <description><![CDATA[Mistral OCR is an open-source (AGPL-3.0-or-later) Nextcloud ExApp by deltadrai and contributors. It sends your PDFs and images to the Mistral OCR API and turns them into machine-readable Markdown text.

Features:

- Task Processing provider for `core:image2text:ocr` (usable from the Assistant app, Talk and any Task Processing consumer)
- "Recognize text with Mistral OCR" file action in the Files app
- Flow (workflow engine) operation for automatic OCR on file created / updated / tag assigned
- Sidecar Markdown output (`<name>.md`), task-result output, or file description
- Persistent job queue with a fingerprint guard (unchanged files are not re-OCR'd)
- EU endpoint (`https://api.eu.mistral.ai`) for data residency

The Mistral API key is stored encrypted via the AppAPI secrets mechanism and is never
logged or returned by API responses. Source code, issue tracker and documentation:
https://github.com/deltadrai/mistral-ocr-nextcloud]]></description>
    <version>0.1.18</version>
    <licence>AGPL-3.0-or-later</licence>
    <author homepage="https://github.com/deltadrai">Deltadrai</author>
    <author>Markus Winter</author>
    <namespace>MistralOcr</namespace>
    <documentation>
        <user>https://github.com/deltadrai/mistral-ocr-nextcloud#usage</user>
        <admin>https://github.com/deltadrai/mistral-ocr-nextcloud#installation--registration</admin>
        <developer>https://github.com/deltadrai/mistral-ocr-nextcloud#development</developer>
    </documentation>
    <category>files</category>
    <category>integration</category>
    <category>ai</category>
    <website>https://github.com/deltadrai/mistral-ocr-nextcloud</website>
    <bugs>https://github.com/deltadrai/mistral-ocr-nextcloud/issues</bugs>
    <repository type="git">https://github.com/deltadrai/mistral-ocr-nextcloud</repository>
    <dependencies>
        <!-- AppAPI identifies ExApps by the presence of <external-app>; a <backend> element
             is only valid for CalDAV backends and fails app-store schema validation. -->
        <nextcloud min-version="30" max-version="35"/>
    </dependencies>
    <external-app>
        <docker-install>
            <registry>ghcr.io</registry>
            <image>deltadrai/mistral-ocr-nextcloud</image>
            <!-- Pinned to <version>; the app store refuses floating tags. -->
            <image-tag>0.1.18</image-tag>
        </docker-install>
        <routes>
            <route>
                <url>^/api/v1/(ocr|flow|jobs|status|health).*$</url>
                <verb>GET,POST</verb>
                <access_level>USER</access_level>
            </route>
            <route>
                <url>^/api/v1/admin/.*$</url>
                <verb>GET,POST</verb>
                <access_level>ADMIN</access_level>
            </route>
            <route>
                <url>^/admin$</url>
                <verb>GET</verb>
                <access_level>ADMIN</access_level>
            </route>
            <route>
                <url>^/img/.*$</url>
                <verb>GET</verb>
                <access_level>USER</access_level>
            </route>
            <route>
                <!-- Files-page script injected through AppAPI's ui/script API -->
                <url>^/js/.*$</url>
                <verb>GET</verb>
                <access_level>USER</access_level>
            </route>
        </routes>
    </external-app>
</info>
